    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO audit_log (tenant_id, correlation_id, actor, actor_role, action, object_type, object_id, outcome, release_id, event_hash) SELECT $1, $2::uuid, $3, $4, $5, $6, $7, $8, $9, 'sha256:' || encode(sha256(convert_to($10, 'UTF8')), 'hex') WHERE NOT EXISTS (SELECT 1 FROM audit_log WHERE tenant_id=$1 AND action=$5 AND object_id=$7);",
