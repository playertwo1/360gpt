{
  "id": "8c883187-34e0-4e6c-b9cf-087dc66ad650",
  "name": "WF-09 — Ponte hospedada para o Estado 360 (OFFLINE_EVAL)",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] } },
      "id": "9e9fcfe2-b339-4433-9a71-982b322325eb", "name": "Verificar fila a cada minuto",
