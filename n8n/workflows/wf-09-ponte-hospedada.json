    },
    {
      "parameters": {
        "method": "POST", "url": "https://visao-360-diretor.fael360092.chatgpt.site/api/bridge/claim", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth",
        "sendBody": true, "contentType": "json", "specifyBody": "json", "jsonBody": "={{JSON.stringify({worker_id: 'n8n-local-wf09'})}}",
        "options": { "response": { "response": { "neverError": true, "responseFormat": "json" } }, "timeout": 15000 }
      },
      "id": "4d954958-28ef-47a4-9482-10db1671502c", "name": "Reservar próximo trabalho",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-660, 80],
      "credentials": { "httpHeaderAuth": { "id": "865fb0bd-dbd8-4352-9718-4eac7f89a382", "name": "Visao 360 Bridge" } }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems", "language": "javaScript",
        "jsCode": "const job = $input.first().json;\nif (!job || Object.keys(job).length === 0 || job.empty === true) return [];\nif (job.ok !== true) throw new Error(`BRIDGE_CLAIM_${job.error ?? 'INVALID'}`);\nif (!job.job_id || !job.lease_token || job.security?.external_effects_allowed !== false) throw new Error('BRIDGE_JOB_INVALID');\nreturn [{ json: job }];"
      },
      "id": "0b63d164-4ccc-4d40-8275-660d1987a92c", "name": "Validar trabalho reservado",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-420, 80]
    },
    {
      "parameters": { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{Boolean($json.document)}}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" } },
      "id": "a82f7932-6bfd-4a2c-928e-d3ea8de74014", "name": "Possui documento?",
