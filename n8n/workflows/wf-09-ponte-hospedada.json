    },
    {
      "parameters": {
        "url": "={{'https://visao-360-diretor.fael360092.chatgpt.site' + $json.document.download_path}}", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Bridge-Lease-Token", "value": "={{$json.lease_token}}" }] },
        "options": { "response": { "response": { "responseFormat": "file", "outputPropertyName": "attachment" } }, "timeout": 30000 }
      },
      "id": "0c0e2166-9c00-4d12-9ccb-d25c4376849e", "name": "Baixar documento protegido",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [60, -40],
      "credentials": { "httpHeaderAuth": { "id": "865fb0bd-dbd8-4352-9718-4eac7f89a382", "name": "Visao 360 Bridge" } }
    },
    {
      "parameters": {
        "method": "POST", "url": "http://n8n:5678/webhook/visao-360/offline-test-input", "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Visao360-Test-Mode", "value": "OFFLINE_EVAL" }] },
        "sendBody": true, "contentType": "multipart-form-data", "bodyParameters": { "parameters": [
          { "parameterType": "formData", "name": "tenant_id", "value": "={{$('Validar trabalho reservado').item.json.tenant_id}}" },
          { "parameterType": "formData", "name": "source_event_id", "value": "={{$('Validar trabalho reservado').item.json.source_event_id}}" },
          { "parameterType": "formData", "name": "actor_id", "value": "={{$('Validar trabalho reservado').item.json.actor_id}}" },
          { "parameterType": "formData", "name": "subject_ref", "value": "={{$('Validar trabalho reservado').item.json.subject_ref}}" },
          { "parameterType": "formData", "name": "purpose", "value": "offline_evaluation" },
          { "parameterType": "formData", "name": "data_classification", "value": "INTERNAL" },
          { "parameterType": "formData", "name": "text", "value": "={{$('Validar trabalho reservado').item.json.text}}" },
          { "parameterType": "formBinaryData", "name": "attachment", "inputDataFieldName": "attachment" }
        ] }, "options": { "timeout": 120000 }
      },
      "id": "3391f4de-b36f-4e50-a165-814f98cf0267", "name": "Processar documento no fluxo 360",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [300, -40]
    },
    {
      "parameters": {
        "method": "POST", "url": "http://n8n:5678/webhook/visao-360/offline-test-input", "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "X-Visao360-Test-Mode", "value": "OFFLINE_EVAL" }] },
        "sendBody": true, "contentType": "json", "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({tenant_id: $json.tenant_id, source_event_id: $json.source_event_id, actor_id: $json.actor_id, subject_ref: $json.subject_ref, purpose: 'offline_evaluation', data_classification: 'INTERNAL', text: $json.text})}}",
        "options": { "timeout": 120000 }
      },
      "id": "b4ec4d71-c0b1-470e-bccb-1566f6629bc6", "name": "Processar texto no fluxo 360",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [60, 200]
    },
    {
      "parameters": {
        "method": "POST", "url": "https://visao-360-diretor.fael360092.chatgpt.site/api/bridge/complete", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth",
        "sendBody": true, "contentType": "json", "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({job_id: $('Validar trabalho reservado').item.json.job_id, lease_token: $('Validar trabalho reservado').item.json.lease_token, result: $json})}}",
        "options": { "response": { "response": { "neverError": true, "responseFormat": "json" } }, "timeout": 30000 }
      },
      "id": "c6cbb40f-411b-46fe-97d3-891b45713709", "name": "Publicar Estado 360 hospedado",
      "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [560, 80],
      "credentials": { "httpHeaderAuth": { "id": "865fb0bd-dbd8-4352-9718-4eac7f89a382", "name": "Visao 360 Bridge" } }
    },
    {
      "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "const response = $input.first().json;\nif (response.ok !== true) throw new Error(`BRIDGE_COMPLETE_${response.error ?? 'INVALID'}`);\nreturn [{ json: { execution_mode: 'OFFLINE_EVAL', external_effects_allowed: false, bridge_status: 'SUCCEEDED', state_id: response.state_id, state_hash: response.state_hash } }];" },
      "id": "56ae1664-da2f-45b2-aeb7-bec838fa13dc", "name": "Confirmar publicação",
      "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [800, 80]
    }
