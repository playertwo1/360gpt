{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visao360.local/contracts/conta-specialist-request.schema.json",
  "title": "Solicitação mínima para especialista de Conta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "correlation_id",
    "manager_id",
    "specialist_id",
    "capability",
    "tenant_id",
    "purpose",
    "customer_ref",
    "reference_at",
    "data_classification",
    "requested_topics",
    "source_refs"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": { "$ref": "handoff.schema.json#/$defs/uuid" },
    "run_id": { "$ref": "handoff.schema.json#/$defs/uuid" },
    "correlation_id": { "$ref": "handoff.schema.json#/$defs/uuid" },
    "manager_id": { "const": "GERENTE_GERAL_CONTA" },
    "specialist_id": {
      "enum": [
        "CONTA_IDENTIDADE_QUALIDADE",
        "CONTA_PROSPECCAO_OXIGENACAO",
        "CONTA_CICLO_VIDA_SAUDE",
        "CONTA_ATIVIDADE_CENTRALIZACAO",
        "CONTA_RISCO_ELEGIBILIDADE",
        "CONTA_CREDITO_APRENDIZADO"
      ]
    },
    "capability": { "type": "string", "minLength": 3 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "customer_ref": { "type": "string", "minLength": 1 },
    "reference_at": { "type": "string", "format": "date-time" },
    "data_classification": { "enum": ["INTERNAL", "CONFIDENTIAL"] },
    "requested_topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_version", "captured_at"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "source_version": { "type": "string", "minLength": 1 },
          "captured_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
