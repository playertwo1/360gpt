{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diretor360.local/contracts/async-processing-status.schema.json",
  "title": "Diretor 360 asynchronous intake status",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "document_id", "job_id", "state", "updated_at"],
  "properties": {
    "protocol": { "type": "string", "minLength": 1, "maxLength": 160 },
    "document_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "job_id": { "type": ["string", "null"], "maxLength": 160 },
    "state": { "enum": ["RECEIVED", "PROCESSING", "AWAITING_RETRY", "READY_FOR_REVIEW", "COMPLETED", "ERROR"] },
    "document_status": { "type": "string", "minLength": 1, "maxLength": 64 },
    "job_status": { "type": ["string", "null"], "maxLength": 64 },
    "attempts": { "type": "integer", "minimum": 0 },
    "error_code": { "type": ["string", "null"], "maxLength": 160 },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
