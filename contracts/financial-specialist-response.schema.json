{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visao360.local/contracts/financial-specialist-response.schema.json",
  "title": "Resposta de especialista Financeiro",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "specialist_id", "base_date", "variance_analysis", "concentration_risks", "attribution_status", "recommendations", "uncertainties", "decision_authority"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "specialist_id": { "type": "string", "pattern": "^FINANCIAL_" },
    "base_date": { "type": "string", "format": "date" },
    "variance_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line_id", "absolute_variance", "relative_variance", "status"],
        "properties": {
          "line_id": { "type": "string" },
          "absolute_variance": { "type": "number" },
          "relative_variance": { "type": ["number", "null"] },
          "status": { "enum": ["ABOVE_BUDGET", "ON_BUDGET", "BELOW_BUDGET", "UNDETERMINED"] }
        }
      }
    },
    "concentration_risks": { "type": "array", "items": { "type": "string" } },
    "attribution_status": { "enum": ["CONFIRMED", "ESTIMATED", "UNKNOWN"] },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "expected_financial_direction", "confidence", "requires_owner_approval"],
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "expected_financial_direction": { "enum": ["POSITIVE", "NEUTRAL", "NEGATIVE", "UNKNOWN"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "requires_owner_approval": { "const": true }
        }
      }
    },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "decision_authority": { "const": "RAFAEL" }
  }
}
