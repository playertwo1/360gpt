{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visao360.local/contracts/routing-decision.schema.json",
  "title": "Decisão de roteamento Visão 360",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "routing_id", "routing_method", "rule_id", "intent", "selected_domains", "excluded_domains", "dependencies", "fallback", "decision_status"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "routing_id": { "type": "string", "format": "uuid" },
    "routing_method": { "enum": ["DETERMINISTIC", "MODEL_ASSISTED"] },
    "rule_id": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "selected_domains": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "requirement", "capabilities"],
        "properties": {
          "domain": { "enum": ["conta", "performance", "financeiro", "relacionamento"] },
          "requirement": { "enum": ["REQUIRED", "OPTIONAL"] },
          "capabilities": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "excluded_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "reason_code"],
        "properties": {
          "domain": { "enum": ["conta", "performance", "financeiro", "relacionamento"] },
          "reason_code": { "enum": ["NOT_REQUIRED_FOR_INTENT", "DEPENDENCY_NOT_MET", "CAPABILITY_UNAVAILABLE"] }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before", "after"],
        "properties": {
          "before": { "type": "string", "minLength": 1 },
          "after": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fallback": { "const": "MANUAL_REVIEW_REQUIRED" },
    "decision_status": { "enum": ["READY", "MANUAL_REVIEW_REQUIRED"] }
  }
}
