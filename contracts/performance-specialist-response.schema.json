{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visao360.local/contracts/performance-specialist-response.schema.json",
  "title": "Resposta de especialista de Performance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "specialist_id", "base_date", "evidence_status", "ranked_actions", "challenges", "uncertainties", "decision_authority"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "specialist_id": { "type": "string", "pattern": "^PERFORMANCE_" },
    "base_date": { "type": "string", "format": "date" },
    "evidence_status": { "enum": ["SUFFICIENT", "PARTIAL", "INSUFFICIENT"] },
    "ranked_actions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "indicator_id", "action", "threshold_position", "expected_point_gain", "effort", "why_now", "confidence", "requires_owner_approval"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
          "indicator_id": { "type": "string" },
          "action": { "type": "string", "minLength": 1 },
          "threshold_position": { "enum": ["BELOW_MINIMUM", "NEAR_MINIMUM", "BETWEEN_MINIMUM_AND_TARGET", "NEAR_TARGET", "BETWEEN_TARGET_AND_CAP", "AT_OR_ABOVE_CAP"] },
          "expected_point_gain": { "type": ["number", "null"], "minimum": 0 },
          "effort": { "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] },
          "why_now": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "requires_owner_approval": { "const": true }
        }
      }
    },
    "challenges": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "uncertainties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "decision_authority": { "const": "RAFAEL" }
  }
}
