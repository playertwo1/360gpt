{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visao360.local/contracts/financial-specialist-request.schema.json",
  "title": "Solicitação para especialista Financeiro",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "manager_id", "specialist_id", "reference_month", "base_date", "source_status", "line_items"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "manager_id": { "const": "GERENTE_GERAL_FINANCEIRO" },
    "specialist_id": {
      "enum": ["FINANCIAL_SOURCES_RECONCILIATION", "FINANCIAL_CALCULATION_STATE", "FINANCIAL_DIAGNOSIS_CONCENTRATION", "FINANCIAL_SCENARIOS_ATTRIBUTION", "FINANCIAL_OUTCOMES_LEARNING"]
    },
    "reference_month": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
    "base_date": { "type": "string", "format": "date" },
    "source_status": { "enum": ["OFFICIAL_CLOSED", "OFFICIAL_PARTIAL", "OWNER_PROVIDED", "SYNTHETIC"] },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_id", "budget", "actual", "unit", "source_ref"],
        "properties": {
          "line_id": { "type": "string", "minLength": 1 },
          "budget": { "type": "number" },
          "actual": { "type": "number" },
          "unit": { "enum": ["BRL", "PERCENT", "COUNT", "INDEX"] },
          "source_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "known_attribution_rules": { "type": "array", "items": { "type": "string" } }
  }
}
